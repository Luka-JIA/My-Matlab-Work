%根据热传导方程式实现一维可视化温度变化图
%基础数据
L=1.0;
Delx=0.05;
N=L/Delx+1;
alpha=1.0;
Delt=0.001;
T=0.2;
tstep=T/Delt;

%初始条件
temp=zeros(N,tstep+1);
%放入开水
t0=1;
n0=1;
temp(n0,t0)=100;

%函数实现
F=alpha*Delt/(Delx)^2;
for t=1:tstep                                                              
    for n=2:N-1 
        temp(n,t+1)=temp(n,t)+F*[temp(n+1,t)-2*temp(n,t)+temp(n-1,t)];
    end
end

%图像呈现
n=linspace(0,L,N);
for t=1:tstep+1
    plot(n,temp(:,t));
    xlabel('distance');
    ylabel('temperature');
    ylim([-5, 105])
    drawnow;
    pause(2);
end
