题1函数：编写能对单词或句子进行摩尔斯编码的函数 [code]=encode_bfs_string(string)
function [code]=encode_bfs_string(s)
    code=[];
    n=length(s);
    for i=1:n
        if s(i)==' '
            code=[code,' '];
            continue;
        end
        M=morse_tree;
        m={M};
        d={''};
        while ~isempty(m)
            node=m{1};
            m=m(2:end);
            cod=d{1};
            d=d(2:end);
            if ~isempty(node)
                if node{1}==s(i)
                    code=[code,cod,' '];
                    break;
                else
                    m=[m,node(3),node(2)];
                    d=[d,{[cod '-']},{[cod '.']}];
                end
            end
        end
    end
end
题2函数：编写能将编码还原为字符串的函数[string]=decode_string(code)
function [string]=decode_string(code)
    string=[];
    M=morse_tree;
    for i=1:length(code)
        if code(i)==' '
            string=[string,M{1},' '];
            M=morse_tree;
            continue;
        elseif code(i)=='  '
            string=[string,M{1},' '];
            M=morse_tree;
            continue;
        else
            if code(i)=='.'
                M=M{2};
            elseif code(i)=='-'
                M=M{3};
            end
        end
        
    end
end
