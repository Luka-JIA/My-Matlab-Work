function [min_val,min_point]=limit1(x_range,y_range,f)
% [X,Y]=meshgrid(x_range,y_range);
% Z=f(X,Y);
nx=length(x_range);
ny=length(y_range);
Z=zeros(nx,ny);

for i=1:nx
    for j=1:ny
        Z(i,j)=f(x_range(i),y_range(j));
    end
end
[min_val,min_lin]=min(Z(:));
[row, col] = ind2sub(size(Z), min_lin);
min_point = [x_range(col), y_range(row)];
%min_point应该包含两架飞机在满足最小间距条件的最优调整角度
end

function d_min=dis_min(x,y,p)   %x，y为调整角
v=800;
t_max=160*sqrt(2)/v;
d_min=inf;

for i=1:6
    p{i}(3)=p{i}(3)*pi/180;
end
p{1}(3)=p{1}(3)+x*pi/180;
p{4}(3)=p{4}(3)+y*pi/180;

for i=1:5
    for j=i+1:6  %要求必须是i+1，避免重复  
        delx=p{i}(1)-p{j}(1);
        dely=p{i}(2)-p{j}(2);
        delv_x=v*(cos(p{i}(3))-cos(p{j}(3)));
        delv_y=v*(sin(p{i}(3))-sin(p{j}(3)));

        A=delv_x^2+delv_y^2;
        B=2*(delx*delv_x+dely*delv_y);
        C=delx^2+dely^2;

        if A==0
           d_ex=C;
        else
            mid=-B/(2*A);
            if mid<0
                d_ex=C;
            elseif t_max<mid
                t=t_max;
                d_ex=A*(t^2)+B*t+C;
            elseif t_max>=mid
                d_ex=C-B^2/(4*A);
            end
        end
        d_min=min(d_min,sqrt(max(0,d_ex)));
    end
end
end

function d_min=pair_dist(x,y,i,j,p)
v=800;
t_max=160*sqrt(2)/v;
d_min=inf;

for k=1:6
    p{k}(3)=p{k}(3)*pi/180;
end
p{1}(3)=p{1}(3)+x*pi/180;
p{4}(3)=p{4}(3)+y*pi/180;

delx=p{i}(1)-p{j}(1);
dely=p{i}(2)-p{j}(2);
delv_x=v*(cos(p{i}(3))-cos(p{j}(3)));
delv_y=v*(sin(p{i}(3))-sin(p{j}(3)));

A=delv_x^2+delv_y^2;
B=2*(delx*delv_x+dely*delv_y);
C=delx^2+dely^2;

if A==0
    d_ex=C;
else
    mid=-B/(2*A);
    if mid<0
        d_ex=C;
    elseif t_max<mid
        t=t_max;
        d_ex=A*(t^2)+B*t+C;
    elseif t_max>=mid
        d_ex=C-B^2/(4*A);
    end
end
d_min=min(d_min,sqrt(max(0,d_ex)));
end
